---
// src/components/Inicio.astro
// Contenido de la sección de inicio.
---

<section class="hero">
  <div class="container">
    <h1>¿Conoce la nueva generación de HOSPITALES DIGITALES?</h1>
    <p>+ 50 CLÍNICAS Y HOSPITALES ya confían en nosotros.</p>
    {/* El botón ahora podría tener un enlace interno o activar otra función JS si es necesario */}
    {/* Este botón también podría usar data-section para ir a la sección de contacto */}
    <a href="#" class="cta-button" data-section="contacto-section">Solicita aquí tu presentación</a>
  </div>
</section>

<style>
  /* Estilos específicos para la sección hero (Inicio) */
  .hero {
    background-color: var(--color-secondary); /* Fondo gris claro */
    text-align: center;
    padding: 100px 20px; /* Aumenta aún más el padding de la sección hero */
  }

  .hero h1 {
    font-size: 3.5rem; /* Aumenta el tamaño de fuente del título principal */
    margin-bottom: 20px;
    color: var(--color-typography-dark);
  }

  .hero p {
    font-size: 1.4rem; /* Aumenta el tamaño de fuente del párrafo */
    margin-bottom: 50px; /* Aumenta el espacio debajo del párrafo */
    color: var(--color-text-body);
  }

  /* Estilos responsivos para la sección hero */
  @media (max-width: 768px) {
    .hero {
        padding: 80px 20px; /* Ajusta padding en móviles */
    }

    .hero h1 {
      font-size: 2.5rem; /* Ajusta tamaño de título en móviles */
    }

    .hero p {
      font-size: 1.1rem; /* Ajusta tamaño de párrafo en móviles */
    }
  }
</style>
