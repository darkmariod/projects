---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Desarrollo web",
    description:
      "Transforma tu negocio y conéctalo al futuro con un sitio web profesional.",
    icon: "bx:bxs-briefcase",
  },
  {
    title: "Ahorra tiempo",
    description:
      "Simplificamos la tecnología para que tú te enfoques en lo que realmente impulsa tu negocio.",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "Configura menos, crece más",
    description:
      "Ahorra tiempo en integraciones y enfócate en hacer crecer tu negocio en el mundo digital",
    icon: "bx:bxs-data",
  },

];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Todo para tu sitio web y tu negocio digital  
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    De manera fácil, eficaz y profesional, conectamos tu empresa al mundo digital.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
