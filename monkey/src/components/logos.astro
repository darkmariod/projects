---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">Las mejores tecnologías para optimizar tu negocio desde el inicio. </h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <Icon class="size-8 md:size-12" name="simple-icons:javascript" />
    <Icon class="size-8 md:size-12" name="simple-icons:laravel" />
    <Icon class="size-8 md:size-12" name="simple-icons:wordpress" />
    <Icon class="size-8 md:size-16" name="simple-icons:python" />
    <Icon class="size-8 md:size-16" name="simple-icons:google" />
  </div>
</div>
